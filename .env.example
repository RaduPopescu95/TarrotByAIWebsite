# Google Analytics 4 (production only; set measurement id from GA Admin)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Set to false to disable GA without removing the id
NEXT_PUBLIC_GA_ENABLED=true

# Ads (manual AdSense + CMP TCF)
NEXT_PUBLIC_ADS_ENABLED=true
NEXT_PUBLIC_ENABLE_ADSENSE=true
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADSENSE_SLOT_AFTER_HERO=1234567890
NEXT_PUBLIC_ADSENSE_SLOT_IN_FEED=1234567890
NEXT_PUBLIC_ADS_CONSENT_REQUIRED=true
NEXT_PUBLIC_ADS_DEBUG=false

# CMP TCF (generic script loader)
NEXT_PUBLIC_CMP_ENABLED=true
NEXT_PUBLIC_CMP_PROVIDER=cookiebot
NEXT_PUBLIC_CMP_SCRIPT_SRC=https://consent.cookiebot.com/uc.js
NEXT_PUBLIC_CMP_SITE_ID=
NEXT_PUBLIC_CMP_COOKIEBOT_CBID=00000000-0000-0000-0000-000000000000
NEXT_PUBLIC_CMP_COOKIEBOT_BLOCKING_MODE=auto

# Adsterra (replaces AdSense when enabled)
NEXT_PUBLIC_ENABLE_ADSTERRA=false
# Native Banner (container-* on effectivecpmnetwork / effectivegatecpm)
NEXT_PUBLIC_ADSTERRA_SCRIPT_HOST=//plXXXXXXXX.effectivegatecpm.com
NEXT_PUBLIC_ADSTERRA_KEY_NATIVE=your-native-container-key
NEXT_PUBLIC_ADSTERRA_NATIVE_HOST=
# Standard iframe banners (atOptions on highperformanceformat.com)
NEXT_PUBLIC_ADSTERRA_KEY_BANNER_1=your-banner-key-300x250
NEXT_PUBLIC_ADSTERRA_BANNER_1_FORMAT=iframe
NEXT_PUBLIC_ADSTERRA_BANNER_1_HOST=https://www.highperformanceformat.com
NEXT_PUBLIC_ADSTERRA_BANNER_1_WIDTH=300
NEXT_PUBLIC_ADSTERRA_BANNER_1_HEIGHT=250
NEXT_PUBLIC_ADSTERRA_KEY_BANNER_2=your-banner-key-468x60
NEXT_PUBLIC_ADSTERRA_BANNER_2_FORMAT=iframe
NEXT_PUBLIC_ADSTERRA_BANNER_2_HOST=https://www.highperformanceformat.com
NEXT_PUBLIC_ADSTERRA_BANNER_2_WIDTH=468
NEXT_PUBLIC_ADSTERRA_BANNER_2_HEIGHT=60
NEXT_PUBLIC_ADSTERRA_KEY_BANNER_3=your-banner-key-728x90
NEXT_PUBLIC_ADSTERRA_BANNER_3_FORMAT=iframe
NEXT_PUBLIC_ADSTERRA_BANNER_3_HOST=https://www.highperformanceformat.com
NEXT_PUBLIC_ADSTERRA_BANNER_3_WIDTH=728
NEXT_PUBLIC_ADSTERRA_BANNER_3_HEIGHT=90
NEXT_PUBLIC_ADSTERRA_MAX_SLOTS_PER_PAGE=3

# Legacy/deprecated (ignored in runtime)
NEXT_PUBLIC_ENABLE_MONETAG=false
# Firestore read telemetry (set to false for an immediate kill switch).
FIRESTORE_READ_TELEMETRY_ENABLED=true
FIRESTORE_READ_TELEMETRY_SAMPLE_RATE=0.1

# Public cache: manifest-check pattern.
# How often (ms) the API checks Firestore's manifest doc to detect changes.
# Within this window, requests are served from in-memory rows (0 reads).
# Outside it, only the manifest (1 read) is fetched; chunks are re-fetched
# only when `manifest.updatedAt` changes (dashboard edit/upload/delete).
# Legacy aliases `ARTICLES_PUBLIC_CACHE_TTL_MS` and `VIDEO_LIBRARY_CACHE_TTL_MS`
# are still honored when the new vars are not set.
ARTICLES_MANIFEST_VERIFY_INTERVAL_MS=30000
VIDEO_LIBRARY_MANIFEST_VERIFY_INTERVAL_MS=30000

# Maximum cache chunks loaded on cold start / manifest-change refetch.
# Articles are stored newest-first (~5-6 articles per chunk in production,
# so 10 chunks ≈ 50-60 newest articles, enough for the Expo MAX_LIMIT=50).
# Videos are pre-sorted (~50 videos per chunk, so 4 chunks ≈ 200 newest).
# Set to 0 (or negative) to load all chunks (original behaviour).
ARTICLES_MAX_CHUNKS_TO_LOAD=10
VIDEO_LIBRARY_MAX_CHUNKS_TO_LOAD=4

# Android Google Play Billing via RevenueCat. All flows are disabled and remain
# on Stripe unless both the flow flag and provider are explicitly enabled.
ANDROID_BILLING_PREMIUM_ENABLED=false
ANDROID_BILLING_PREMIUM_PROVIDER=stripe
ANDROID_BILLING_ANALYSES_ENABLED=false
ANDROID_BILLING_ANALYSES_PROVIDER=stripe

# Server-only RevenueCat credentials (never expose these as NEXT_PUBLIC_*).
REVENUECAT_WEBHOOK_AUTH_TOKEN=
REVENUECAT_SECRET_API_KEY=
REVENUECAT_PREMIUM_PRODUCT_ID=
REVENUECAT_PREMIUM_ENTITLEMENT_ID=premium
REVENUECAT_ANALYSIS_PRODUCT_PERSONAL=
REVENUECAT_ANALYSIS_PRODUCT_ASTROGRAMA_OTHERS=
REVENUECAT_ANALYSIS_PRODUCT_SINASTRIE_ONE_PERSON=
REVENUECAT_ANALYSIS_PRODUCT_SINASTRIE_OTHERS=

# Dashboard authentication (server-only; never expose through NEXT_PUBLIC_*).
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=

# Sentry (proiect web separat — vezi ../SENTRY_SETUP.md)
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=cristina-zurba-web
SENTRY_AUTH_TOKEN=
# Set true only when smoke-testing: GET /api/sentry-test
SENTRY_TEST_ROUTE_ENABLED=false
