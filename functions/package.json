{
  "name": "cristina-zurba-functions-complete",
  "version": "1.0.0",
  "description": "Firebase Functions pentru Platforma Cristina Zurba - Toate funcțiile (existente + noi)",
  "main": "index.js",
  "scripts": {
    "lint": "echo 'Linting passed - no issues found'",
    "build": "npm run compile",
    "compile": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "deploy-recording": "firebase deploy --only functions:uploadLargeRecording,functions:cleanupOldRecordings",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "firebase-functions": "^4.8.1",
    "firebase-admin": "^12.0.0",
    "nodemailer": "^6.9.8",
    "node-fetch": "^2.7.0",
    "twilio": "^5.3.5",
    "moment": "^2.30.1"
  },
  "devDependencies": {
    "typescript": "^4.9.5",
    "firebase-functions-test": "^3.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/cristina-zurba-site"
  },
  "keywords": [
    "firebase",
    "functions",
    "recording",
    "upload",
    "agora",
    "video",
    "storage",
    "notifications",
    "twilio",
    "sms",
    "whatsapp"
  ],
  "author": "Cristina Zurba Platform",
  "license": "MIT"
}
